# AUR package (Arch, Manjaro): publish with an AUR account, see
# https://wiki.archlinux.org/title/AUR_submission_guidelines. On a new release,
# update pkgver and sha256sums (updpkgsums), then makepkg --printsrcinfo > .SRCINFO.
pkgname=lethe
pkgver=0.5.2
pkgrel=1
pkgdesc='Browse, resume and forget your Claude Code and Codex sessions'
arch=('any')
url='https://github.com/C0sm0cats/lethe'
license=('MIT')
depends=('bash' 'fzf' 'jq' 'sqlite')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('c561839e1fbc7bcd0cb349dab242aa1ace2b500cf8f9baf3cfd939f5c470a6e2')

package() {
    cd "$pkgname-$pkgver"
    install -Dm755 lethe "$pkgdir/usr/bin/lethe"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -d "$pkgdir/usr/share/bash-completion/completions"
    ./lethe completion bash >"$pkgdir/usr/share/bash-completion/completions/lethe"
}
